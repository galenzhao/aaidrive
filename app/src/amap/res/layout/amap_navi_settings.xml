            android:text="@string/lbl_amap_cameras" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapCameraDistance}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_camera_distance" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapOverspeedPulse}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_overspeed_pulse" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapEyrieCross}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_eyrie_cross" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapNaviPopTips}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_navi_pop_tips" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapCarOverlay}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_car_overlay" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapTrafficLights}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_traffic_lights" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapTrafficLightView}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_traffic_light_view" />

        <androidx.appcompat.widget.SwitchCompat
