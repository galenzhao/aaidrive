<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="settings"
            type="me.hufman.androidautoidrive.phoneui.viewmodels.MapSettingsModel" />
    </data>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/lbl_amap_settings_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/lbl_amap_settings_section_hint"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/lbl_amap_settings_live_hint"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <!-- Route -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/lbl_amap_section_route"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapSelectRoute}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_select_route" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapMultipleRoute}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_multiple_route" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapAvoidCongestion}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_avoid_congestion" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapAvoidHighway}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_avoid_highway" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapAvoidCost}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_avoid_cost" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapPreferHighway}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_prefer_highway" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/settings_vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/lbl_amap_route_strategy" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/lbl_amap_route_strategy_hint"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_amap_route_strategy"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="48dp"
                android:text="@={settings.amapRouteStrategy}" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapDrawBackupRoute}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_draw_backup_route" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapRouteAutoGray}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_route_auto_gray" />

        <!-- Vehicle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/lbl_amap_section_vehicle"
            android:textStyle="bold" />

        <LinearLayout
