            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_drive_congestion" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapRestrictAreaInfo}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_restrict_area_info" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapTrafficLine}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_traffic_line" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapEagle}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_eagle" />

        <androidx.appcompat.widget.SwitchCompat
