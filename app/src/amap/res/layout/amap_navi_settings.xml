                android:inputType="number"
                android:minHeight="48dp"
                android:text="@={settings.amapLockZoom}" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapNightAuto}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_night_auto" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapNight}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_night" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapLayout}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_layout" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapLaneInfo}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_lane_info" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapCrossView}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_cross_view" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapSecondAction}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_second_action" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapTrafficBar}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_traffic_bar" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapCompass}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_compass" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapScale}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_scale" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapMapText}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_map_text" />

        <androidx.appcompat.widget.SwitchCompat
            android:checked="@={settings.amapLockCar}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingBottom="@dimen/settings_vertical_margin"
            android:text="@string/lbl_amap_lock_car" />

        <androidx.appcompat.widget.SwitchCompat
